# Root-level backend environment variables for local development.
# Copy this file to .env in the project root and replace placeholders.
# For production deploys, set these in your hosting provider's secret env config.

DB_PASSWORD=your_supabase_db_password
JWT_SECRET=replace_with_a_long_random_secret_32_plus_chars
# First admin, created once on boot (password must be 12+ characters).
# Responders are then created by that admin via /api/v1/admin/responders.
ADMIN_LOGIN=admin@your-domain.test
ADMIN_PASSWORD=replace_with_at_least_12_characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
PORT=8080
